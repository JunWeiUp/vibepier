[Unit]
Description=vibepier remote relay (WebSocket, behind nginx)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/vibepier-relay -listen 127.0.0.1:47801 -secret %d/secret
Restart=always
RestartSec=2
# Needs systemd >= 247: the root-only secret is handed to the unprivileged dynamic user.
DynamicUser=yes
LoadCredential=secret:/etc/vibepier-relay/secret
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
MemoryMax=64M

[Install]
WantedBy=multi-user.target
